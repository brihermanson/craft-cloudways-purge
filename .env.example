# Cloudways API credentials for the cache purge module.
# Populate on production only. Leaving CLOUDWAYS_ACCESS_TOKEN empty keeps
# the module inert, which is what you want locally and on staging.

# Access token created in the Cloudways platform (API Integration).
# Scope it to the cache purge endpoints only.
CLOUDWAYS_ACCESS_TOKEN=""

# Numeric IDs from the Cloudways platform URLs.
CLOUDWAYS_SERVER_ID=""
CLOUDWAYS_APP_ID=""

# API base URL. Leave empty to use the module's default.
CLOUDWAYS_API_BASE=""

# true also purges Varnish server-wide, which affects every app on the
# server. Leave false unless the app-level purge doesn't clear Varnish.
CLOUDWAYS_PURGE_SERVER_VARNISH=false
